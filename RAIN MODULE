local IgnoredInstances = {}

local function addToIgnore(instance)
	if not instance or IgnoredInstances[instance] then
		return
	end

	IgnoredInstances[instance] = true
	instance.AncestryChanged:Connect(function()
		if not instance:IsDescendantOf(game) then
			IgnoredInstances[instance] = nil
		end
	end)
end

local function getIgnoreList()
	local list = {}
	for instance in pairs(IgnoredInstances) do
		if instance:IsDescendantOf(game) then
			table.insert(list, instance)
		else
			IgnoredInstances[instance] = nil
		end
	end
	return list
end

