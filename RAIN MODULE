	if not x or x.Magnitude < 1e-4 then x = perp(up) else x = x.Unit end
	return CFrame.fromMatrix(pos, x, up)
end

---------------------------------------------------------------- physics (SI based)
-- Everything dynamic is evaluated in SI units and converted to studs with two numbers:
--   WorldScale  studs per metre (Roblox convention: 1 stud = 0.28 m = 3.571 studs/m)
--   time scale  chosen so that Workspace.Gravity equals 9.81 m/s^2 in that unit system. Falling drops, drips and sliding
--               beads therefore obey the same gravity as every other part in the game, and follow it if a game changes it.
-- Models: Marshall-Palmer drop sizes, Atlas et al. terminal speeds, quadratic air drag (wind = relative velocity),
-- Furmidge's sliding condition for a bead on a plate (gravity vs contact-line pinning) with viscous contact-line friction.
local G0, RHO_W, GAMMA, K_WIND = 9.81, 1000, 0.072, 9.0e-4
local REF_SPEED = 72 -- fall speed (studs/s) that FallRate / MaxFall were tuned at; keeps the visual rain density unchanged
local GE = Workspace.Gravity
local LS, TS, VS, AS = 3.571, 2.366, 8.452, 20 -- studs/m, rate scale, velocity scale (studs/s per m/s), acceleration scale
local lamV, meanD, rainSpeed = 2, 2, REF_SPEED

local function terminalSpeed(dmm) -- m/s for a drop of dmm millimetres (Atlas et al. 1973 fit to Gunn & Kinzer)
	if dmm < 0.3 then dmm = 0.3 end
	return 9.65 - 10.3 * exp(-0.6 * dmm)
end

local function sampleDiameter() -- mm; mass-weighted Marshall-Palmer (the drops that actually carry the rain) = Gamma(4, 1/lambda)
	local theta = 1 / lamV
	for _ = 1, 4 do
		local d = -theta * math.log(rng:NextNumber() * rng:NextNumber() * rng:NextNumber() * rng:NextNumber() + 1e-9)
		if d >= CFG.DropMinMM and d <= CFG.DropMaxMM then return d end
	end
	return meanD
end

local function updatePhysics()
	GE = max(Workspace.Gravity, 1)
	LS = max(CFG.WorldScale, 0.1)
	AS = GE / G0
	TS = sqrt(AS / LS)
	VS = LS * TS
	lamV = 4.1 * max(CFG.Intensity, 0.1) ^ (-0.21) -- Marshall-Palmer slope (1/mm)
	meanD = clamp(4 / lamV, CFG.DropMinMM, CFG.DropMaxMM)
end

-- accelerations on a bead sitting on a surface with normal n (studs/s^2): the driving push along the surface, and the pinning threshold
local function forces(n, Dm, hyst, flow, out)
	local drive = V3(0, -GE, 0)
	drive = drive - n * drive:Dot(n)
	if W.X ~= 0 or W.Z ~= 0 then -- aerodynamic drag of the wind on the bead (reduced by the boundary layer: SlideInfluence)
		local wt = W - n * W:Dot(n)
		local wm = wt.Magnitude
		if wm > 1e-3 then
			local u = wm / VS * CFG.SlideInfluence
			drive = drive + wt * ((K_WIND * u * u / Dm * AS) / wm)
		end
	end
	if flow then -- small tops: water films over the rim, so no pinning and a gentle push toward the edge
		if drive.Magnitude < GE * 0.2 then drive = drive + out * (GE * 0.3) end
		return drive, 0
	end
	return drive, 6 * GAMMA * hyst / (pi * RHO_W * Dm * Dm) * AS -- Furmidge: m*g*sin(a) > gamma*w*(cos_r - cos_a), w ~ D
end

