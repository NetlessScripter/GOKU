local function splash(pos, n, cnt, big)
	if splashN >= (big and 12 or 6) or not CFG.Enabled then return end
	splashN += 1
	local s
	if big then
		bigSplashI = bigSplashI % #bigSplashes + 1
		s = bigSplashes[bigSplashI]
	else
		splashI = splashI % #splashes + 1
		s = splashes[splashI]
	end
	s.a.WorldCFrame = frame(pos + n * 0.02, n)
	s.e:Emit(cnt or 2)
end

local pGE, pLS = 0, 0
local function syncSplash() -- ejected droplets are ballistic too: world gravity, ~0.6-1.8 m/s ejection, flight time follows
	local flight = 2.2 * VS / GE
	for _, s in ipairs(splashes) do
		s.e.Acceleration = V3(0, -GE, 0)
		s.e.Speed = NumberRange.new(0.6 * VS, 1.8 * VS)
		s.e.Lifetime = NumberRange.new(flight * 0.5, flight * 1.5)
	end
	local bigFlight = 6 * VS / GE
	for _, s in ipairs(bigSplashes) do
		s.e.Acceleration = V3(0, -GE, 0)
		s.e.Speed = NumberRange.new(0.8 * VS, 2 * VS)
		s.e.Lifetime = NumberRange.new(bigFlight * 0.5, bigFlight * 1.2)
	end
end

---------------------------------------------------------------- droplets
local newDrop, startDrip, isBodyPart, isWetPart
local ap = 0.12

local function bodyModelOf(instance) -- the character / NPC model a part belongs to (nil for everything else)
	local m = instance:FindFirstAncestorOfClass("Model")
	if m and m:FindFirstChildOfClass("Humanoid") then return m end
	return nil
end

function newDrop(res, sizeMul)
	local inst, n, pos = res.Instance, res.Normal, res.Position
	if res.Material == Enum.Material.Water then return end
	local dist = (pos - camPos).Magnitude
	if dist > 85 then return end
	if n.Y > 0.3 and rng:NextNumber() < 0.5 then splash(pos, n, 2) end
	local p = getBead()
	if not p then return end
	local f = rand(CFG.SizeMin, CFG.SizeMax) * (sizeMul or 1) -- one random factor drives the drawn size and the physical diameter
	local sz = CFG.DropSize * f * (1 + dist / 40)
	local Dm = CFG.NominalDiameter * f * 0.001 -- bead diameter in metres
	local fl = CFG.Flatness
	local tr = rand(CFG.TransMin, CFG.TransMax)
	p.Transparency = tr
	p.Size = V3(sz, sz * fl, sz) * 0.25
	local cf = frame(pos + n * (sz * fl * 0.2), n)
	p.CFrame = cf
	p.Parent = rainF

	local host, hcf = nil, nil
	if not inst.Anchored then host = inst; hcf = inst.CFrame end

	-- can this bead run? gravity along the surface (+ wind) has to beat the contact-line pinning of its material
	if #L < CFG.MaxSliders * q and dist < 60 and rng:NextNumber() < CFG.SlideChance then
		local body = isBodyPart(proxyOf[inst] or inst)
		local hBase = body and 0.45 or (HYST[res.Material.Name] or 0.5)
		local hyst = hBase * CFG.Hysteresis * rand(0.75, 1.3)
		local small = n.Y > 0.5 and inst.Size.Magnitude < 14 and hBase < 1.2
		local out = pos - inst.Position
		out = out - n * out:Dot(n)
		out = out.Magnitude > 1e-3 and out.Unit or perp(n)
		local drive, pin = forces(n, Dm, hyst, small, out)
		if drive.Magnitude > pin * 1.1 or n.Y < CFG.DetachAngle then
			local V0 = pi * Dm * Dm * Dm / 6
			local s = {
				p = p, pos = pos, nrm = n, vel = ZERO, sz = sz, sz0 = sz, fl = fl, tr = tr,
				sw = sz * rand(CFG.WidthMin, CFG.WidthMax), th = sz * fl * 0.6,
				tail = pos, born = now, life = rand(CFG.SliderLifeMin, CFG.SliderLifeMax),
				acc = 0, nxt = rand(CFG.StepMin, CFG.StepMax), ph = rand(0, 6.28),
				out = out, flow = small, slow = 0, host = host, hcf = hcf, hi = inst,
				segMax = max(sz * 5, 0.25),
				Dm = Dm, Dm0 = Dm, V = V0, V0 = V0, hyst = hyst,
			}
			s.sw0 = s.sw
			if CFG.Trails then
				local seg = getBead()
				if seg then
					seg.Transparency = min(1, tr + 0.12); seg.Size = V3(0.01, 0.01, 0.01)
					seg.CFrame = cf; seg.Parent = rainF
					s.seg = seg
				end
			end
			L[#L + 1] = s
			return
		end
	end
	S[#S + 1] = {
		p = p, pos = pos, nrm = n, sz = sz, fl = fl, cf = cf, born = now,
		life = rand(CFG.StaticLifeMin, CFG.StaticLifeMax), host = host, hcf = hcf,
	}
end

function startDrip(pos, vel, sz, bead, Dm, hi)
	if not CFG.Drips or #D >= 60 then
		vanish(bead, bead.Size)
		return
	end
	-- src: the body this bead left, so it can't land back on the body it fell off
	D[#D + 1] = { p = bead, pos = pos, vel = vel, sz = sz, born = now, vt = terminalSpeed((Dm or 0.003) * 1000), src = hi and bodyModelOf(proxyOf[hi] or hi) or nil }
end

local function segCF(s, a, b)
	local d = b - a
	local l = d.Magnitude
	if l < 1e-4 then return nil, nil end
	return V3(l + s.sw, s.th, s.sw), frame((a + b) * 0.5 + s.nrm * (s.th * 0.25), s.nrm, d / l)
end

local function stampTrail(s, keep)
	local seg = s.seg
	if not seg then return end
	local size, cf = segCF(s, s.tail, s.pos)
	if not size then
		if not keep then drop(seg); s.seg = nil end
		return
	end
	seg.Size = size; seg.CFrame = cf
	T[#T + 1] = {
		p = seg, born = now, life = rand(CFG.TrailLifeMin, CFG.TrailLifeMax), len = size.X, th = s.th, sw = s.sw,
		t0 = seg.Transparency, nu = now + 0.1, host = s.host, hcf = s.hcf, cf = cf,
	}
	s.seg = nil
	if keep then
		local nb = getBead()
		if nb then
			nb.Transparency = min(1, s.tr + 0.12); nb.Size = V3(0.01, 0.01, 0.01)
			nb.CFrame = cf; nb.Parent = rainF
			s.seg = nb
		end
	end
	s.tail = s.pos
end

local function finishSlider(s)
	stampTrail(s, false)
	-- a tired bead on a wet body / model lets go and falls instead of just fading out
	local n = s.nrm
	if CFG.Drips and n.Y < CFG.ShedMaxNormal and rng:NextNumber() < CFG.ShedChance and isWetPart(proxyOf[s.hi] or s.hi) then
		startDrip(s.pos + n * 0.02, ZERO, s.sz, s.p, s.Dm, s.hi)
		return
	end
	vanish(s.p, s.p.Size)
end

-- returns 0 = keep, 1 = end, 2 = became a drip
local function stepSlider(s, h)
	local n, pos = s.nrm, s.pos

	-- pendant bead: on an underside it hangs, elongates as it swells, then pinches off from rest
	if not s.hang and n.Y < CFG.DetachAngle then
		stampTrail(s, false)
		s.hang = now; s.hangT = rand(0.12, 0.4); s.fl0 = s.fl; s.vel = ZERO
	end
	if s.hang then
		local k = clamp((now - s.hang) / s.hangT, 0, 1)
		s.fl = s.fl0 + (1.15 - s.fl0) * k * k
		if k >= 1 then
			startDrip(pos + n * 0.02, ZERO, s.sz, s.p, s.Dm, s.hi)
			return 2
		end
		return 0
	end

	-- force balance along the surface: gravity + wind shear - contact-line pinning, resisted by contact-line friction
	local drive, pin = forces(n, s.Dm, s.hyst, s.flow, s.out)
	local dm = drive.Magnitude
	local net = dm > pin and drive * (1 - pin / dm) or ZERO
	local cE = 6 * CFG.ContactFriction / (pi * RHO_W * s.Dm * s.Dm) * TS
	local v = (s.vel + net * h) / (1 + cE * h)
	v = v - n * v:Dot(n)
	local spd = v.Magnitude
	if spd < CFG.MinFlow then s.slow += h else s.slow = 0 end
	if s.slow > 0.4 then return 1 end

	local d = v * h
	if spd > 0.02 then
		d = d + n:Cross(v / spd) * (sin(now * CFG.WobbleSpeed + s.ph) * CFG.Wobble * spd * h)
	end
	local dl = d.Magnitude
	if dl < 1e-5 then s.vel = v; return 0 end
	local dir = d / dl
	local snap = CFG.SurfaceSnap
	local np = pos + d
	local res

	-- obstacle ahead (inner corner / wall)
	res = ray(pos + n * snap, dir * (dl + s.sz * 0.6))
	if res and res.Normal:Dot(n) < 0.95 then
		np = res.Position
	else
		res = ray(np + n * snap, -n * (snap * 2 + s.sz))
		if not res then
			res = ray(np + dir * CFG.SeamForgive + n * snap, -n * (snap * 2 + s.sz))
		end
		if not res then
			-- wrap around the edge onto the side face
			res = ray(np - n * 0.3, -dir * (dl + 0.4))
		end
		if not res then
			-- ran off an edge: the bead leaves with the speed it had
			stampTrail(s, false)
			startDrip(np + n * 0.01, v, s.sz, s.p, s.Dm, s.hi)
			return 2
		end
	end

	local rn = res.Normal
	local nn
	if n:Dot(rn) > 0.5 then
		nn = n * CFG.NormalSmoothing + rn * (1 - CFG.NormalSmoothing)
		nn = nn.Magnitude > 1e-3 and nn.Unit or rn
	else
		nn = rn
	end
	s.pos = res.Position; s.nrm = nn
	s.vel = v - nn * v:Dot(nn)
	local hi = res.Instance
	if hi ~= s.hi then
		s.hi = hi
		if hi.Anchored then s.host = nil; s.hcf = nil else s.host = hi; s.hcf = hi.CFrame end
	end

	-- the moving bead leaves a thin film behind it: it loses volume, shrinks, and stops once pinning wins (pinning grows as 1/D^2)
	local ds = (res.Position - pos).Magnitude / LS
	s.V -= 0.5 * s.Dm * CFG.FilmThickness * 1e-6 * ds
	if s.V < s.V0 * 0.166 then return 1 end
	s.Dm = (6 * s.V / pi) ^ (1 / 3)
	local sh = s.Dm / s.Dm0
	s.sz = s.sz0 * sh; s.th = s.sz * s.fl * 0.6; s.sw = s.sw0 * sh

	if s.seg and (s.pos - s.tail).Magnitude >= s.segMax then stampTrail(s, true) end
	return 0
end

local function drawSlider(s)
	local age = now - s.born
	local k = min(1, 0.25 + 0.75 * age / ap)
	local spd = s.vel.Magnitude
	local dir = spd > 0.02 and s.vel / spd or s.out
	local pp = s.pos + s.vel * s.acc
	local n = s.nrm
	local st = 1 + CFG.SlideStretch * clamp(spd / 3, 0, 1) * 2
	s.p.Size = V3(s.sz * st, s.sz * s.fl, s.sz) * k
	mv(s.p, frame(pp + n * (s.sz * s.fl * 0.2), n, dir))
	if s.seg then
		local size, cf = segCF(s, s.tail, pp)
		if size then s.seg.Size = size; mv(s.seg, cf) end
	end
end

---------------------------------------------------------------- precise characters (accessories / special meshes)
local queued, pq, extraProxyList = {}, {}, {}
local function scanChar(m, extra)
	if not CFG.PreciseMesh then return end
	local all = m:GetDescendants()
	all[#all + 1] = m -- a loose MeshPart is its own target
	for _, d in ipairs(all) do
		if not queued[d] then
			if d:IsA("MeshPart") and d.MeshId ~= "" then
				queued[d] = true
				pq[#pq + 1] = { part = d, id = d.MeshId, extra = extra }
			elseif d:IsA("SpecialMesh") and d.MeshType == Enum.MeshType.FileMesh and d.MeshId ~= "" and d.Parent and d.Parent:IsA("BasePart") then
				queued[d] = true
				pq[#pq + 1] = { part = d.Parent, id = d.MeshId, sm = d, extra = extra }
			end
		end
	end
end

local function makeProxy(job)
	local orig = job.part
	if not orig.Parent or not CFG.PreciseMesh then return end
	if job.extra and #extraProxyList >= CFG.MaxProxies then queued[job.sm or orig] = nil; return end
	local mp = AssetService:CreateMeshPartAsync(Content.fromUri(job.id), { CollisionFidelity = Enum.CollisionFidelity.PreciseConvexDecomposition })
	if not alive or not orig:IsDescendantOf(Workspace) then mp:Destroy(); return end
	local off = CFrame.identity
	if job.sm then
		mp.Size = mp.Size * job.sm.Scale
		off = CFrame.new(job.sm.Offset)
	else
		mp.Size = orig.Size
	end
	mp.CFrame = orig.CFrame * off
	mp.Anchored = false; mp.CanCollide = false; mp.CanQuery = true; mp.CanTouch = false
	mp.Massless = true; mp.Transparency = 1; mp.CastShadow = false
	mp.Parent = proxyF
	local w = Instance.new("WeldConstraint"); w.Part0 = orig; w.Part1 = mp; w.Parent = mp
	proxyOf[mp] = orig
	excl[#excl + 1] = orig
	if job.extra then extraProxyList[#extraProxyList + 1] = { mp = mp, orig = orig, key = job.sm or orig } end
	filtersDirty = true
	orig.Destroying:Connect(function()
		proxyOf[mp] = nil
		mp:Destroy()
		filtersDirty = true
	end)
end

task.spawn(function()
	while alive do
		local job = table.remove(pq, 1)
		if job then
			pcall(makeProxy, job)
			task.wait(0.12)
		else
			task.wait(0.4)
		end
	end
end)

---------------------------------------------------------------- characters / sheltered
local chars, nextChars, nextScan = {}, 0, 0
---------------------------------------------------------------- extra wet targets (models, NPCs, props, loose parts)
local extras = {}
local extraParams = OverlapParams.new()
extraParams.FilterType = Enum.RaycastFilterType.Exclude
extraParams.MaxParts = CFG.ModelScanParts
local wetUnits = setmetatable({}, { __mode = "k" })    -- model / loose part -> os.clock() until which it counts as wet
local unitSmall = setmetatable({}, { __mode = "k" })
local unitScanned = setmetatable({}, { __mode = "k" })

local function smallUnit(u) -- big models (the map, buildings) are left to the normal rain; only things up to ModelMaxSize studs get aimed rain
	local small = unitSmall[u]
	if small == nil then
		local size = u:IsA("Model") and u:GetExtentsSize() or u.Size
		small = size.Magnitude <= CFG.ModelMaxSize
		unitSmall[u] = small
	end
	return small
end

local function pruneProxies() -- proxies made for models / props go away again once you've walked off
	for i = #extraProxyList, 1, -1 do
		local e = extraProxyList[i]
		local gone = e.orig.Parent == nil
		if gone or (e.orig.Position - camPos).Magnitude > CFG.ModelRadius * 2.5 then
			if not gone then
				proxyOf[e.mp] = nil
				e.mp:Destroy()
				for k = #excl, 1, -1 do
					if excl[k] == e.orig then rem(excl, k) break end
				end
				queued[e.key] = nil
				filtersDirty = true
			end
			rem(extraProxyList, i)
		end
	end
end

local function refreshExtras()
	pruneProxies()
	local list = {}
	if CFG.Models and CFG.MaxModels > 0 then
		local filter = { rainF, proxyF }
		if cam then filter[#filter + 1] = cam end
		for _, m in ipairs(models) do filter[#filter + 1] = m end -- player characters have their own targeting
		extraParams.FilterDescendantsInstances = filter
		extraParams.MaxParts = CFG.ModelScanParts
		local found = Workspace:GetPartBoundsInRadius(camPos, CFG.ModelRadius, extraParams)
		local count = #found
		local start = count > 0 and rng:NextInteger(1, count) or 1
		local picked = {}
		for k = 0, count - 1 do
			if #list >= CFG.MaxModels then break end
			local p = found[(start + k - 1) % count + 1]
			if p.CanQuery and p.Transparency < 0.8 and p.ClassName ~= "Terrain" then
				local u = p:FindFirstAncestorOfClass("Model") or p
				if not picked[u] and smallUnit(u) then
					picked[u] = true
					wetUnits[u] = now + 3
					if not unitScanned[u] or now - unitScanned[u] > 10 then
						unitScanned[u] = now
						scanChar(u, true)
					end
					list[#list + 1] = {
						p = p, ex = clamp(max(p.Size.X, p.Size.Z) * 0.5, 0.5, 3),
						sh = sheltered(p.Position + V3(0, p.Size.Magnitude * 0.5 + 0.5, 0)),
					}
				end
			end
		end
	end
	extras = list
end

local function refreshChars()
	local list, ms = {}, {}
	for _, pl in ipairs(Players:GetPlayers()) do
		local c = pl.Character
		local r = c and c:FindFirstChild("HumanoidRootPart")
		if r then
			ms[#ms + 1] = c
			if pl == plr or (r.Position - camPos).Magnitude < 55 then
				list[#list + 1] = { m = c, r = r, loc = pl == plr, sh = false }
			end
		end
	end
	models = ms
	filtersDirty = true
	setFilters()
	for _, c in ipairs(list) do c.sh = sheltered(c.r.Position + V3(0, 3, 0)) end
	chars = list
	if now >= nextScan then
		nextScan = now + 2
		for i = 1, min(#list, 6) do scanChar(list[i].m) end
	end
	refreshExtras()
end

---------------------------------------------------------------- falling drops
local fallParts, fallFree, fallDrops = {}, {}, {}
local fallSpawnAccumulator = 0
local bodyDropAccumulator = 0
local modelDropAccumulator = 0
local bodyPartCache = setmetatable({}, { __mode = "k" })

function isBodyPart(instance)
	local cached = bodyPartCache[instance]
	if cached ~= nil then return cached end
	local model = instance:FindFirstAncestorOfClass("Model")
	local result = model ~= nil and model:FindFirstChildOfClass("Humanoid") ~= nil
	bodyPartCache[instance] = result
	return result
end

local wetUnitCache = setmetatable({}, { __mode = "k" })
function isWetPart(instance) -- a body, or a model / prop that is currently being wetted
	if isBodyPart(instance) then return true end
	local unit = wetUnitCache[instance]
	if unit == nil then
		unit = instance:FindFirstAncestorOfClass("Model") or instance
		wetUnitCache[instance] = unit
	end
	local wetUntil = wetUnits[unit]
	return wetUntil ~= nil and wetUntil > now
end

local function newFallDrop()
	local part = Instance.new("Part")
	part.Shape = Enum.PartType.Cylinder
	part.Anchored = true; part.CanCollide = false; part.CanTouch = false; part.CanQuery = false
	part.CastShadow = false; part.Material = MAT; part.Color = COL; part.Transparency = CFG.FallTrans
	part.Size = V3(1, 0.05, 0.05)
	fallParts[#fallParts + 1] = part
	return { part = part }
end

local function fallRaycast(origin, direction, ignoreModel) -- ignoreModel: a drip passes through the body it fell off
	local unit = direction.Unit
	for _ = 1, 6 do
		local result = Workspace:Raycast(origin, direction, rp)
		if not result then return nil end
		local base = proxyOf[result.Instance] or result.Instance
		if base.Transparency <= 0.9 and base.LocalTransparencyModifier <= 0.9
			and not (ignoreModel and base:IsDescendantOf(ignoreModel)) then return result end
		local advance = (result.Position - origin).Magnitude + 0.05
		if advance >= direction.Magnitude then return nil end
		origin = origin + unit * advance
		direction = unit * (direction.Magnitude - advance)
	end
	return nil
end

local function spawnFallDrop(aimPoint)
	local target = aimPoint
	if not target then
		local nearZone = rng:NextNumber() < CFG.FallNearShare
		local zoneRadius = nearZone and CFG.FallNearRadius or CFG.FallFarRadius
		local angle = rand(0, 2 * pi)
		local offsetDistance = zoneRadius * sqrt(rng:NextNumber())
		local center = camPos + flatLook * (zoneRadius * (nearZone and 0.35 or 0.5))
		target = V3(center.X + cos(angle) * offsetDistance, camPos.Y, center.Z + sin(angle) * offsetDistance)
	end
	-- every drop has its own size, hence its own terminal speed; horizontally it moves with the air, so bigger drops fall steeper in wind
	local diameter = sampleDiameter()
	local velocity = V3(W.X, -terminalSpeed(diameter) * VS * rand(0.97, 1.03), W.Z)
	local speed = velocity.Magnitude
	local direction = velocity / speed
	local startHeight = CFG.RoofHeight
	local origin = target - direction * startHeight
	local travelLimit = startHeight + 60
	local hit = fallRaycast(origin, direction * travelLimit)
	local travel = hit and (hit.Position - origin).Magnitude or travelLimit
	local cameraDistance = (target - camPos).Magnitude
	local length = speed * CFG.Shutter * (1 + cameraDistance / 60) -- motion-blur streak = speed x exposure time
	local width = CFG.FallWidth * (diameter / 2) * (1 + cameraDistance / 35)
	local lifetime = (travel - length * 0.5) / speed
	if lifetime <= 0.02 then return end

	local fallDrop = table.remove(fallFree) or newFallDrop()
	local part = fallDrop.part
	local rotation = CFrame.fromMatrix(ZERO, direction, direction:Cross(Vector3.xAxis).Unit)
	local birth = now - rand(0, dt)
	part.Size = V3(length, width, width)
	part.Transparency = 1 - (1 - CFG.FallTrans) * clamp(diameter / 2, 0.35, 2) -- a streak's brightness scales with the drop's diameter
	part.CFrame = rotation + (origin + velocity * (now - birth))
	part.Parent = rainF
	fallDrop.origin = origin
	fallDrop.velocity = velocity
	fallDrop.rotation = rotation
	fallDrop.birth = birth
	fallDrop.lifetime = lifetime
	local hitBase = hit and (proxyOf[hit.Instance] or hit.Instance)
	fallDrop.onBody = hitBase ~= nil and isWetPart(hitBase)
	fallDrop.landing = not fallDrop.onBody and hit and hit.Material ~= Enum.Material.Water and hit.Normal.Y > 0.3 and hit.Position or nil
	fallDrop.normal = fallDrop.landing and hit.Normal or nil
	fallDrops[#fallDrops + 1] = fallDrop
end


---------------------------------------------------------------- spawn rays
local function areaRay()
	local R = CFG.AreaRadius
	local a, r = rand(0, 2 * pi), R * sqrt(rng:NextNumber())
	local c = camPos + flatLook * (R * 0.4)
	local target = V3(c.X + cos(a) * r, camPos.Y, c.Z + sin(a) * r)
	local H = CFG.RoofHeight
	local vel = V3(W.X, -terminalSpeed(sampleDiameter()) * VS, W.Z)
	local dir = vel.Unit
	local res = ray(target - dir * H, dir * (H + 90))
	if res and not isBodyPart(proxyOf[res.Instance] or res.Instance) then newDrop(res, 1) end
end

---------------------------------------------------------------- main update
local spawnAcc, nextCam = 0, 0
local function update(delta)
	dt = clamp(delta, 1 / 240, 0.1)
	now = os.clock()
	rays, splashN = 0, 0
	cam = Workspace.CurrentCamera
	if not cam then return end
	local cf = cam.CFrame
	camPos = cf.Position
	local lk = cf.LookVector
	flatLook = V3(lk.X, 0, lk.Z)
	flatLook = flatLook.Magnitude > 0.01 and flatLook.Unit or ZERO

	-- quality governor
	fpsAvg += (1 / dt - fpsAvg) * 0.04
	if CFG.AutoQuality then
		if fpsAvg < CFG.TargetFPS then q = max(0.3, q - dt * 0.15)
		elseif fpsAvg > CFG.TargetFPS + 8 then q = min(1, q + dt * 0.05) end
	else q = 1 end
	rayCap = floor(40 * q) + 10

	-- physics scales follow Workspace.Gravity / WorldScale / Intensity live
	updatePhysics()
	if GE ~= pGE or LS ~= pLS then pGE, pLS = GE, LS; syncSplash() end

	-- wind: horizontal air velocity (m/s -> studs/s). Drops move with the air sideways and fall at their own terminal speed
	if CFG.Wind then
		local a = rad(CFG.WindDir)
		local gust = 1 + CFG.Gustiness * math.noise(now * CFG.GustSpeed, 17.3) * 2
		W = V3(sin(a), 0, cos(a)) * (CFG.WindStrength * max(gust, 0) * VS)
	else W = ZERO end
	local rainVel = V3(W.X, -terminalSpeed(meanD) * VS, W.Z) -- representative drop: used for roof checks and the density scaling
	rainDir = rainVel.Unit
	rainSpeed = rainVel.Magnitude

	if filtersDirty then setFilters() end
	if now >= nextChars then nextChars = now + 0.5; refreshChars() end
	if now >= nextCam then nextCam = now + 0.25; camSh = sheltered(camPos) end
	ap = max(CFG.AppearTime, 0.02)

	-- spawn
	if CFG.Enabled and not camSh then
		local want = CFG.Rate * q * dt + spawnAcc
		local n = floor(want)
		spawnAcc = want - n
		for _ = 1, min(n, 8) do
			if rays >= rayCap then break end
			areaRay()
		end
	else spawnAcc = 0 end

	-- statics
	for i = #S, 1, -1 do
		local o = S[i]
		local age = now - o.born
		if age >= o.life then
			vanish(o.p, V3(o.sz, o.sz * o.fl, o.sz)); rem(S, i)
		else
			if age < ap then
				o.p.Size = V3(o.sz, o.sz * o.fl, o.sz) * (0.25 + 0.75 * age / ap)
			elseif not o.full then
				o.p.Size = V3(o.sz, o.sz * o.fl, o.sz); o.full = true
			end
			local h = o.host
			if h then
				if h.Parent == nil then
					drop(o.p); rem(S, i)
				else
					local c = h.CFrame
					if c ~= o.hcf then
						local d = c * o.hcf:Inverse()
						o.hcf = c; o.cf = d * o.cf
						mv(o.p, o.cf)
					end
				end
			end
		end
	end

	-- sliders
	for i = #L, 1, -1 do
		local s = L[i]
		local status = 0
		local h = s.host
		if h then
			if h.Parent == nil then
				status = 1
			else
				local c = h.CFrame
				if c ~= s.hcf then
					local d = c * s.hcf:Inverse()
					s.hcf = c
					s.pos = d * s.pos; s.tail = d * s.tail
					s.nrm = d:VectorToWorldSpace(s.nrm)
					s.vel = d:VectorToWorldSpace(s.vel)
					s.out = d:VectorToWorldSpace(s.out)
				end
			end
		end
		if status == 0 then
			if now - s.born > s.life then
				status = 1
			else
				s.acc += dt
				if s.acc >= s.nxt and rays < rayCap then
					local hh = min(s.acc, 0.15)
					s.acc = 0; s.nxt = rand(CFG.StepMin, CFG.StepMax)
					status = stepSlider(s, hh)
				end
			end
		end
		if status == 1 then finishSlider(s); rem(L, i)
		elseif status == 2 then rem(L, i)
		else drawSlider(s) end
	end

	-- trails
	for i = #T, 1, -1 do
		local t = T[i]
		local age = now - t.born
		if age >= t.life then
			drop(t.p); rem(T, i)
		else
			local h = t.host
			if h then
				if h.Parent == nil then
					drop(t.p); rem(T, i); continue
				end
				local c = h.CFrame
				if c ~= t.hcf then
					local d = c * t.hcf:Inverse()
					t.hcf = c; t.cf = d * t.cf
					mv(t.p, t.cf)
				end
			end
			if now >= t.nu then
				local f = age / t.life
				local k = 1 - CFG.AgeTaper * f
				t.p.Size = V3(t.len, t.th * k, t.sw * k)
				t.p.Transparency = t.t0 + (1 - t.t0) * f * f * f
				t.nu = now + t.life / 10
			end
		end
	end

	-- drips: ballistic under world gravity, with quadratic air drag toward each bead's own terminal speed (relative to the wind)
	for i = #D, 1, -1 do
		local d = D[i]
		local h = min(dt, 0.05)
		local vtE = d.vt * VS
		local c = GE * (d.vel - W).Magnitude / (vtE * vtE)
		local v = (d.vel + (V3(0, -GE, 0) + W * c) * h) / (1 + c * h)
		local rel = v - W -- speed through the air can't overshoot terminal speed on a long frame (a bead dropped into a gust may start above it)
		local relMax = max(vtE * 1.1, (d.vel - W).Magnitude)
		local relMag = rel.Magnitude
		if relMag > relMax then v = W + rel * (relMax / relMag) end
		local spd = v.Magnitude
		local step = v * h
		local done = false
		if now - d.born > 3.5 or d.pos.Y < camPos.Y - 160 then
			done = true
		else
			local res = fallRaycast(d.pos, step + v.Unit * d.sz, d.src) -- every frame, no ray budget: a drip never tunnels through the ground
			if res then
				if res.Material ~= Enum.Material.Water then
					splash(res.Position, res.Normal, CFG.DripSplash, true)
					if CFG.Relanding then newDrop(res, 1.1) end
				end
				done = true
			else
				d.pos = d.pos + step; d.vel = v
				local dirv = v / max(spd, 1e-3)
				d.p.Size = V3(d.sz + spd * CFG.Shutter, d.sz * 0.9, d.sz * 0.9) -- motion blur grows with speed
				mv(d.p, frame(d.pos, perp(dirv), dirv))
			end
		end
		if done then drop(d.p); rem(D, i) end
	end


	-- vanishing
	for i = #V, 1, -1 do
		local v = V[i]
		local k = 1 - (now - v.t0) / 0.18
		if k <= 0 then drop(v.p); rem(V, i) else v.p.Size = v.sz * k end
	end

	if CFG.Enabled and not camSh then
		local wantedDrops = CFG.FallRate * q * dt * (rainSpeed / REF_SPEED) + fallSpawnAccumulator
		local spawnCount = floor(wantedDrops)
		fallSpawnAccumulator = wantedDrops - spawnCount
		for _ = 1, min(spawnCount, 100) do
			if #fallDrops >= CFG.MaxFall then break end
			spawnFallDrop()
		end

		if #chars > 0 then
			local wantedBodyDrops = CFG.BodyRate * q * dt * min(#chars, 6) + bodyDropAccumulator
			local bodySpawnCount = floor(wantedBodyDrops)
			bodyDropAccumulator = wantedBodyDrops - bodySpawnCount
			for _ = 1, min(bodySpawnCount, 60) do
				if #fallDrops >= CFG.MaxFall then break end
				local character = chars[rng:NextInteger(1, #chars)]
				local cameraInsideLocal = character.loc and (camPos - character.r.Position).Magnitude < 2.2
				if not character.sh and not cameraInsideLocal then
					spawnFallDrop(character.r.Position + V3(rand(-1.7, 1.7), 0, rand(-1.7, 1.7)))
				end
			end
		end

		if #extras > 0 then
			local wantedModelDrops = CFG.ModelRate * q * dt * min(#extras, 6) + modelDropAccumulator
			local modelSpawnCount = floor(wantedModelDrops)
			modelDropAccumulator = wantedModelDrops - modelSpawnCount
			for _ = 1, min(modelSpawnCount, 40) do
				if #fallDrops >= CFG.MaxFall then break end
				local target = extras[rng:NextInteger(1, #extras)]
				if target.p.Parent and not target.sh then
					local c = target.p.Position
					spawnFallDrop(V3(c.X + rand(-target.ex, target.ex), c.Y, c.Z + rand(-target.ex, target.ex)))
				end
			end
		else
			modelDropAccumulator = 0
		end
	else
		fallSpawnAccumulator = 0
		bodyDropAccumulator = 0
		modelDropAccumulator = 0
	end

	for dropIndex = #fallDrops, 1, -1 do
		local fallDrop = fallDrops[dropIndex]
		local age = now - fallDrop.birth
		if age >= fallDrop.lifetime then
			if fallDrop.onBody then
				local fallDirection = fallDrop.velocity.Unit
				local currentPosition = fallDrop.origin + fallDrop.velocity * age
				local bodyHit = fallRaycast(currentPosition - fallDirection * 1.2, fallDirection * 4)
				if bodyHit and isWetPart(proxyOf[bodyHit.Instance] or bodyHit.Instance)
					and (bodyHit.Position - camPos).Magnitude > 2.2 then
					newDrop(bodyHit, 1)
				end
			end
			if fallDrop.landing and rng:NextNumber() < CFG.FallSplash then
				splash(fallDrop.landing, fallDrop.normal, 1)
			end
			fallDrop.part.Parent = nil
			fallFree[#fallFree + 1] = fallDrop
			rem(fallDrops, dropIndex)
		else
			mv(fallDrop.part, fallDrop.rotation + (fallDrop.origin + fallDrop.velocity * age))
		end
	end

	-- apply moves
	if mvN > 0 then
		Workspace:BulkMoveTo(mvP, mvC, Enum.BulkMoveMode.FireCFrameChanged)
		table.clear(mvP); table.clear(mvC); mvN = 0
	end
end

local errd = false
conns[#conns + 1] = RunService.RenderStepped:Connect(function(delta)
	if not alive then return end
	local ok, err = pcall(update, delta)
	if not ok and not errd then errd = true; warn("RealRain:", err) end
end)

---------------------------------------------------------------- look / hooks
local function applyLook()
	MAT = Enum.Material[CFG.Material]
	COL = COLORS[CFG.WaterColor] or COLORS[1]
	for _, p in ipairs(beads) do
		p.Material = MAT; p.Color = COL; p.CastShadow = CFG.CastShadow
	end
	for _, part in ipairs(fallParts) do
		part.Material = MAT; part.Color = COL; part.Transparency = CFG.FallTrans
	end
end

local HOOKS = {
	Material = applyLook, WaterColor = applyLook, CastShadow = applyLook, FallTrans = applyLook,
	PreciseMesh = function(v)
		if v then nextScan = 0; for _, c in ipairs(chars) do scanChar(c.m) end end
	end,
}
local function set(key, v)
	CFG[key] = v
	if key == "Enabled" then
		_G.Rain = v == true
		setScreenRainEnabled(v)
	end
	local h = HOOKS[key]
	if h then h(v) end
end
local function preset(name)
	local p = PRESETS[name]
	if not p then return end
	for k, v in pairs(p) do set(k, v) end
end

preset("HIGH")
applyLook()

---------------------------------------------------------------- API
local api = {}
api.Config = CFG
api.Set = set
api.Preset = preset
api.Enable = function() set("Enabled", true) end
api.Disable = function() set("Enabled", false) end
api.Toggle = function() set("Enabled", not CFG.Enabled) end
api.Destroy = function()
	alive = false
	for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
	for _, s in ipairs(splashes) do pcall(function() s.a:Destroy() end) end
	for _, s in ipairs(bigSplashes) do pcall(function() s.a:Destroy() end) end
	for _, e in ipairs(extraProxyList) do pcall(function() e.mp:Destroy() end) end
	for _, d in pairs({ rainF, proxyF }) do pcall(function() d:Destroy() end) end
	pcall(function() ScreenDroplets:Destroy() end)
	pcall(function() RunService:UnbindFromRenderStep("ScreenRainUpdate") end)
	env.RealRain = nil
end
env.RealRain = api
return api
