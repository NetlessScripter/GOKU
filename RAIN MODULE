local function createObjectPool(object, initialAmount)
	local pool = {
		Template = object:Clone(),
		Available = {},
	}

	for _ = 1, math.max(1, math.floor(initialAmount)) do
		table.insert(pool.Available, pool.Template:Clone())
	end

	function pool:Get()
		local objectIndex = #self.Available
		local pooledObject = self.Available[objectIndex]
		if pooledObject then
			table.remove(self.Available, objectIndex)
			return pooledObject
		end
		return self.Template:Clone()
	end

	function pool:Return(objectToReturn)
		objectToReturn.CFrame = DISTANT_CF
		table.insert(self.Available, objectToReturn)
	end

	return pool
end

